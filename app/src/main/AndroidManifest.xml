<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:name=".App"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="一键闪记"
        android:supportsRtl="true"
        android:theme="@style/Theme.PickupCode">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize"
            android:theme="@style/Theme.PickupCode">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 截屏授权 Activity（透明，仅用于请求权限） -->
        <activity
            android:name=".service.CapturePermissionActivity"
            android:exported="false"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <receiver
            android:name=".notification.NotificationDismissReceiver"
            android:exported="false" />

        <receiver
            android:name=".notification.DoneReceiver"
            android:exported="false" />

        <!-- 快捷设置磁贴 -->
        <service
            android:name=".service.PickupCodeTileService"
            android:exported="true"
            android:icon="@drawable/ic_tile_pickup"
            android:label="一键闪记"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

    </application>
</manifest>
